# SAHRA API — environment template
# Copy to .env and fill in real values. .env is gitignored; this file is committed.

# ── Supabase / Postgres ─────────────────────────────────────────────────
# Project: sahra app's Project (org: hellosahra)
SUPABASE_URL=https://jbiycpyhozzrrmulpipt.supabase.co

# Publishable (anon) key — safe for client distribution, guarded by RLS.
# This is the key the Flutter apps ship with.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret key — SERVER ONLY. Bypasses RLS. Never ship this to a Flutter app,
# never commit it, never expose it to a browser.
SUPABASE_SECRET_KEY=

# Prisma connection. Supabase Dashboard → Connect → ORM / Connection string.
# DATABASE_URL  = transaction-mode pooler (port 6543) — what the app runs on.
# DIRECT_URL    = session-mode pooler  (port 5432) — Prisma needs this to migrate;
#                 DDL and advisory locks do not work through the 6543 pooler.
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:[YOUR-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<PROJECT-REF>:[YOUR-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# ── Redis (locks, idempotency keys, BullMQ) ─────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Search ──────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=

# ── Auth ────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Payments (Egypt rails) — sandbox keys for dev ───────────────────────
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=

# ── Messaging ───────────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_PROVIDER_KEY=

# ── Firebase (FCM only — not Firestore, not Firebase Auth) ──────────────
# Leave BOTH empty and the API boots with the stub delivery and says so loudly.
# Setting one without the other is a hard boot error — half-configured means
# somebody believes push is on.
FIREBASE_PROJECT_ID=

# An ABSOLUTE PATH to the service-account JSON, never the JSON itself.
#
# It was FIREBASE_SERVICE_ACCOUNT_JSON (contents inline) and was changed on
# 2026-08-10, before anything read it. Reasons, in order:
#   1. dotenv loads every value here into process.env. One console.log of that
#      object prints the private key. A path is a harmless string.
#   2. A file you hand-edit is a file you paste into a diff or a screenshot.
#      With a path the key never has to be opened.
#   3. The key stays outside the repository entirely.
# Full reasoning: src/shared/config/firebase.config.ts.
#
#   FIREBASE_SERVICE_ACCOUNT_FILE=C:\Users\you\secrets\sahra-xxxxx-firebase-adminsdk-xxxxx.json
FIREBASE_SERVICE_ACCOUNT_FILE=

# Set to 1 ONLY after the APNs auth key is uploaded to Firebase Console →
# Cloud Messaging. Until then every iOS send is refused before it leaves the
# process and recorded as `ios_not_configured`.
#
# It is manual because FCM offers no way to ASK whether an APNs key exists, and
# it accepts an iOS send without one — answering with a message id while the
# handset never rings. Defaulting this to "configured" would make that silence
# look like success.
FIREBASE_IOS_CONFIGURED=

# ── App ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DEFAULT_CURRENCY=EGP

# ── Reverse proxies ─────────────────────────────────────────────────────
# NUMBER OF PROXY HOPS in front of this process. Never `true`, never a
# wildcard: req.ip drives every per-IP rate limit and the refresh-token audit
# trail, and it is derived from a header the client controls. Trusting the
# whole X-Forwarded-For chain makes those limits bypassable by typing a
# different header value.
#
#   local / CI            0   (nothing in front; req.ip is the socket)
#   staging / production  2   (doc 08 §5: Cloudflare -> ALB -> app)
#
# REQUIRED in production — the app refuses to boot without it, because the
# failure mode of forgetting is silent.
TRUST_PROXY_HOPS=0
