// SAHRA — Prisma schema
//
// Mirrors docs/blueprint/04-database-design.md EXACTLY, including index names.
// Do not add or drop an index without checking that doc — each one backs a
// specific P0 query path (DEVELOPMENT.md §5).
//
// SCOPE: P0 tables only (users, roles, user_roles, restaurant_owners,
// restaurants, shifts, tables, reservations, reservation_tables).
// P1/P2 tables (payments, reviews, menus, waitlists, promotions, loyalty…)
// are specified in doc 04 and land when their feature's turn comes.
//
// Three things Prisma cannot express; they live in raw SQL migrations:
//   1. partial indexes (idx_restaurants_active, idx_tables_rest_capacity,
//      idx_resv_active, idx_resv_hold_expiry)
//   2. GIST index on restaurants.location, GIN on restaurants.cuisines
//   3. the EXCLUDE USING GIST anti-double-booking constraint on
//      reservation_tables — the hard backstop under the application lock

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, citext, postgis, btree_gist]
}

// ─────────────────────────────────────────────────────────────── enums ──

enum UserStatus {
  pending
  active
  suspended
  deleted

  @@map("user_status")
}

enum VerificationStatus {
  pending
  verified
  rejected

  @@map("verification_status")
}

enum RestaurantStatus {
  draft
  pending_review
  active
  suspended
  closed

  @@map("restaurant_status")
}

enum BookingMode {
  instant
  request

  @@map("booking_mode")
}

enum TableZone {
  indoor
  outdoor
  family
  bar
  private

  @@map("table_zone")
}

/// Live statuses (held|pending|confirmed|seated) are what availability scans.
/// See idx_resv_active and the reservation_tables.active mirror trigger.
enum ReservationStatus {
  held
  pending
  confirmed
  seated
  completed
  no_show
  cancelled_by_user
  cancelled_by_restaurant
  expired

  @@map("reservation_status")
}

enum ReservationSource {
  app
  walk_in
  phone
  waitlist
  admin

  @@map("reservation_source")
}

// NOTE: OTP state deliberately has NO table here.
// docs/blueprint/09-security-and-scalability.md §1.1 specifies "phone OTP
// hashed in Redis, 5-min TTL, 5 attempts, per-phone and per-IP rate limits".
// A 5-minute secret belongs in a store that expires keys by itself; putting it
// in Postgres would mean millions of dead rows and a cleanup job for nothing.
// See docs/decisions/2026-07-31-auth-token-storage.md.

// ─────────────────────────────────────────────────────────────── users ──

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A CONTACT FIELD, NOT A CREDENTIAL. It identifies nobody and grants
  /// access to nothing — `AuthService.login` matches on `phone` only, and
  /// `auth.e2e-spec.ts` fails if that ever changes. Future Google/Apple
  /// linking must key off `emailVerifiedAt`, never off this column.
  /// CITEXT — case-insensitive uniqueness enforced by the column type.
  email           String?    @unique @db.Citext
  /// E.164, e.g. +201000000000
  phone           String     @unique @db.VarChar(20)
  passwordHash    String?    @map("password_hash")
  fullName        String     @map("full_name") @db.VarChar(120)
  avatarUrl       String?    @map("avatar_url")
  locale          String     @default("ar") @db.Char(2)
  status          UserStatus @default(pending)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  noShowCount     Int        @default(0) @map("no_show_count") @db.SmallInt
  referralCode    String?    @unique @map("referral_code") @db.VarChar(10)
  referredBy      String?    @map("referred_by") @db.Uuid
  marketingOptIn  Boolean    @default(false) @map("marketing_opt_in")
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  referrer        User?             @relation("UserReferral", fields: [referredBy], references: [id], onDelete: SetNull)
  referees        User[]            @relation("UserReferral")
  roles           UserRole[]        @relation("UserRoleUser")
  grantedRoles    UserRole[]        @relation("UserRoleGrantedBy")
  restaurantOwner RestaurantOwner?  @relation("OwnerUser")
  verifiedOwners  RestaurantOwner[] @relation("OwnerVerifiedBy")
  reservations    Reservation[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  devices         Device[]
  favorites       Favorite[]
  waitlists       Waitlist[]
  notifications   Notification[]
  reviews         Review[]

  @@index([status], map: "idx_users_status")
  @@map("users")
}

/// doc 04 §2 — append-only. Every admin decision must be reconstructable
/// later: who did it, under which role, what changed, and from where.
///
/// The append-only guarantee is NOT expressible in Prisma. A trigger in the
/// migration rejects UPDATE, DELETE and TRUNCATE. A trigger rather than
/// GRANTs because the API connects as the table owner, and an owner is not
/// bound by its own GRANTs — an audit trail the operator can quietly edit is
/// not an audit trail.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  /// WHICH role authorised it. 'admin' and 'support' are not interchangeable
  /// when reconstructing a decision months later.
  actorRole  String?  @map("actor_role") @db.VarChar(30)
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.Uuid
  before     Json?    @db.JsonB
  after      Json?    @db.JsonB
  ip         String?  @db.Inet
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// SetNull, never Cascade: erasing a user must not erase the record that
  /// they approved something. PDPL erasure anonymises PII, it does not
  /// rewrite history (doc 04 §2 users).
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([actorId, createdAt(sort: Desc)], map: "idx_audit_actor_created")
  @@map("audit_logs")
}

/// NOT in docs/blueprint/04-database-design.md — added to implement the
/// rotating refresh tokens with reuse detection that doc 06 §2 specifies.
/// Rationale logged in docs/decisions/2026-07-31-auth-token-storage.md.
///
/// Only the SHA-256 of the token is stored. A database leak therefore cannot
/// be replayed against the API — the raw token exists only on the client.
model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// All descendants of one login share a family. Detecting replay of any
  /// member revokes the whole family (doc 06 §2: "reuse → revoke family").
  familyId   String    @map("family_id") @db.Uuid
  /// SHA-256 hex of the opaque token. Never the token itself.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Set when this token is rotated, for audit trails.
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  ip         String?   @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_user")
  @@index([familyId], map: "idx_refresh_family")
  @@index([expiresAt], map: "idx_refresh_expiry")
  @@map("refresh_tokens")
}

model Role {
  id    Int        @id @default(autoincrement()) @db.SmallInt
  name  String     @unique @db.VarChar(30)
  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    Int      @map("role_id") @db.SmallInt
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role    Role  @relation(fields: [roleId], references: [id])
  granter User? @relation("UserRoleGrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId], map: "idx_user_roles_role")
  @@map("user_roles")
}

// ────────────────────────────────────────────────────── restaurant_owners ──

model RestaurantOwner {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  businessName       String             @map("business_name") @db.VarChar(160)
  taxId              String?            @map("tax_id") @db.VarChar(40)
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(6)
  verifiedBy         String?            @map("verified_by") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation("OwnerUser", fields: [userId], references: [id], onDelete: Cascade)
  verifier    User?        @relation("OwnerVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)
  restaurants Restaurant[]

  @@map("restaurant_owners")
}

// ───────────────────────────────────────────────────────────── restaurants ──

model Restaurant {
  id              String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId         String                                @map("owner_id") @db.Uuid
  slug            String                                @unique @db.VarChar(80)
  nameEn          String                                @map("name_en") @db.VarChar(160)
  nameAr          String                                @map("name_ar") @db.VarChar(160)
  descriptionEn   String?                               @map("description_en")
  descriptionAr   String?                               @map("description_ar")
  cuisines        String[]
  phone           String?                               @db.VarChar(20)
  email           String?                               @db.VarChar(160)
  website         String?
  addressEn       String?                               @map("address_en")
  addressAr       String?                               @map("address_ar")
  neighborhood    String?                               @db.VarChar(80)
  city            String                                @default("Cairo") @db.VarChar(80)
  /// PostGIS GEOGRAPHY(POINT,4326). Prisma cannot type this — reads/writes go
  /// through raw SQL in the restaurants repository.
  location        Unsupported("geography(Point, 4326)")
  priceBand       Int?                                  @map("price_band") @db.SmallInt
  amenities       Json?                                 @db.JsonB
  policies        Json?                                 @db.JsonB
  bookingMode     BookingMode                           @default(instant) @map("booking_mode")
  slotIntervalMin Int                                   @default(30) @map("slot_interval_min") @db.SmallInt
  pacingLimit     Int?                                  @map("pacing_limit") @db.SmallInt
  ratingAvg       Decimal                               @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount     Int                                   @default(0) @map("rating_count")
  status          RestaurantStatus                      @default(draft)
  timezone        String                                @default("Africa/Cairo") @db.VarChar(40)
  deletedAt       DateTime?                             @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner        RestaurantOwner @relation(fields: [ownerId], references: [id])
  tables       Table[]
  shifts       Shift[]
  reservations Reservation[]
  favorites    Favorite[]
  waitlists    Waitlist[]
  menus        Menu[]
  reviews      Review[]

  @@index([status, city, neighborhood], map: "idx_restaurants_status_neighborhood")
  @@map("restaurants")
}

/// doc 04 §"images (polymorphic media)".
///
/// NO RELATION FIELD, and that is what polymorphic costs. `ownerId` points at
/// a restaurant, a menu item, a review or a user depending on `ownerType`, and
/// Prisma cannot express "foreign key into one of four tables" — so there is no
/// `@relation` and no database-level FK. Reads join by hand.
///
/// The alternative was four tables with four upload paths. This is the trade
/// doc 04 already made; it is recorded here so the missing FK reads as a
/// consequence rather than an oversight.
model Image {
  id        String         @id @default(uuid()) @db.Uuid
  ownerType ImageOwnerType @map("owner_type")
  ownerId   String         @map("owner_id") @db.Uuid

  /// The BASE STORAGE KEY, not a fetchable address — `restaurants/<id>/<id>`.
  /// Renditions are named from it by convention (`/160.webp` and friends) and
  /// the API composes public URLs in its response. See the migration header.
  url String

  /// Always NULL. `flutter_blurhash` was declined (doc 08 §5); the column is
  /// committed schema so it exists.
  blurhash String? @db.VarChar(50)

  /// The ORIGINAL's pixel dimensions. Every client reserves its box from this
  /// ratio before a byte arrives, so lists do not reflow as photos land.
  width  Int
  height Int

  position Int         @default(0) @db.SmallInt
  isCover  Boolean     @default(false) @map("is_cover")
  status   ImageStatus @default(processing)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerType, ownerId, position], map: "idx_images_owner")
  @@map("images")
}

/// C-2.7 — a venue a diner saved.
///
/// doc 04 names this table in its ER diagram (USERS ||--o{ FAVORITES) but
/// gives it no field table, so the NAME is the document's and the columns are
/// ours. Deliberately thin — see the migration for why there is no `position`.
model Favorite {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId], map: "idx_favorites_unique")
  @@index([userId, createdAt(sort: Desc)], map: "idx_favorites_user")
  @@map("favorites")
}

/// C-3.6 — a diner waiting for a table that is currently full.
///
/// Every field is doc 04 §waitlists, and both index names with it.
model Waitlist {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid

  /// The venue's wall-clock day, not an instant.
  desiredDate DateTime @map("desired_date") @db.Date

  /// The range the diner will actually accept. An offer outside it is worse
  /// than no offer — it teaches them to ignore the next one.
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  windowEnd   DateTime @map("window_end") @db.Timestamptz(6)

  partySize Int            @map("party_size") @db.SmallInt
  status    WaitlistStatus @default(waiting)

  /// Set when a table frees and this entry is offered it. C-3.6: 10 minutes.
  /// A CHECK ties this to `status = 'offered'` in both directions.
  offerExpiresAt DateTime? @map("offer_expires_at") @db.Timestamptz(6)

  /// doc 04: "loyalty tier boost later". Zero for everyone today.
  priority Int @default(0) @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, desiredDate, status], map: "idx_wait_rest_date")
  @@map("waitlists")
}

enum WaitlistStatus {
  waiting
  offered
  converted
  expired
  cancelled

  @@map("waitlist_status")
}

enum ImageOwnerType {
  restaurant
  menu_item
  review
  user

  @@map("image_owner_type")
}

enum ImageStatus {
  processing
  ready
  rejected

  @@map("image_status")
}

// ──────────────────────────────────────────────────── menus (R-2.3, C-2.6) ──

/// doc 04 §"menus / menu_categories / menu_items".
///
/// THREE LEVELS, kept. `VenueDetailScreen.jsx` draws a flat list, which tempts
/// a categories-only design — but a venue holds a food menu AND a drinks menu,
/// and R-2.6's Ramadan mode wants a menu swapped in as a unit for a month.
/// Collapse the top level and `kind: 'ramadan'` becomes unexpressible.
model Menu {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid

  nameEn String   @map("name_en") @db.VarChar(80)
  nameAr String   @map("name_ar") @db.VarChar(80)
  kind   MenuKind @default(food)

  /// A STORAGE KEY, not a fetchable address — same call as `Image.url`, and a
  /// deviation from doc 04's `pdf_url`. R-2.3's PDF fallback matters in Cairo;
  /// nothing in Group D uploads one. See the migration.
  pdfKey String? @map("pdf_key")

  position Int     @default(0) @db.SmallInt
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categories MenuCategory[]

  /// DEFERRABLE in the database, which Prisma cannot express — see the
  /// migration for why a reorder needs it.
  @@unique([restaurantId, position], map: "menus_position_unique")
  @@index([restaurantId, position], map: "idx_menus_rest")
  @@map("menus")
}

model MenuCategory {
  id     String @id @default(uuid()) @db.Uuid
  menuId String @map("menu_id") @db.Uuid

  nameEn   String @map("name_en") @db.VarChar(80)
  nameAr   String @map("name_ar") @db.VarChar(80)
  position Int    @default(0) @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  menu  Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@unique([menuId, position], map: "menu_categories_position_unique")
  @@index([menuId, position], map: "idx_mc_menu")
  @@map("menu_categories")
}

model MenuItem {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  nameEn        String  @map("name_en") @db.VarChar(120)
  nameAr        String  @map("name_ar") @db.VarChar(120)
  descriptionEn String? @map("description_en")
  descriptionAr String? @map("description_ar")

  /// NUMERIC(12,2) per CLAUDE.md rule 5, NOT doc 04's (10,2). The first money
  /// column in the database, and therefore the precedent for every later one:
  /// `payments.amount`, deposits, settlement, commission. See the migration.
  price    Decimal @db.Decimal(12, 2)
  currency String  @default("EGP") @db.Char(3)

  /// The one direction of the polymorphic `images` relation that CAN be a real
  /// foreign key, and is.
  imageId String? @map("image_id") @db.Uuid

  /// Constrained to a fixed vocabulary by a CHECK in the migration, because a
  /// typo here does not fail — it disappears at render time.
  dietaryTags String[] @map("dietary_tags")

  available Boolean @default(true)
  position  Int     @default(0) @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, position], map: "menu_items_position_unique")
  @@index([categoryId, position], map: "idx_mi_cat")
  @@map("menu_items")
}

enum MenuKind {
  food
  drinks
  ramadan
  set

  @@map("menu_kind")
}

// ──────────────────────────────────────────────────────────── reviews (C-4.4) ──

/// doc 04 §reviews.
///
/// `reservationId` NOT NULL and UNIQUE is the whole product: no review without
/// a visit, one review per visit. C-4.4 calls it "a trust wedge vs. Google Maps
/// noise", and the wedge is that one column.
///
/// WHAT THE SCHEMA CANNOT HOLD: "only a SEATED diner may review". A CHECK
/// cannot read another table, and every database mechanism for it makes an
/// unrelated later write fail — once a review exists, an owner correcting the
/// reservation to `no_show` would get a foreign-key error from a table they
/// have never heard of. So it lives in `ReviewsService` with a test per
/// non-eligible status. It is the one invariant in Group D held by code rather
/// than by the database, and it is said here rather than dressed up as
/// enforced.
model Review {
  id            String @id @default(uuid()) @db.Uuid
  reservationId String @unique @map("reservation_id") @db.Uuid
  userId        String @map("user_id") @db.Uuid
  restaurantId  String @map("restaurant_id") @db.Uuid

  rating         Int  @db.SmallInt
  foodRating     Int? @map("food_rating") @db.SmallInt
  serviceRating  Int? @map("service_rating") @db.SmallInt
  ambienceRating Int? @map("ambience_rating") @db.SmallInt

  /// Nullable, which doc 04 does not say. Stars-only reviews are the majority
  /// everywhere they are allowed, and forcing prose gets prose worth nothing.
  body String?

  /// Defaults to `published`. A queue with no moderator is not moderation — it
  /// is a silent drop, and the diner watches their review vanish. See the
  /// migration.
  status ReviewStatus @default(published)

  ownerReply     String?   @map("owner_reply")
  ownerRepliedAt DateTime? @map("owner_replied_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  reservation Reservation @relation(fields: [reservationId], references: [id])
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant  Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status, createdAt(sort: Desc)], map: "idx_reviews_rest")
  @@index([userId, createdAt(sort: Desc)], map: "idx_reviews_user")
  @@map("reviews")
}

enum ReviewStatus {
  published
  pending_moderation
  rejected
  removed

  @@map("review_status")
}

// ─────────────────────────────────────────────────────────── notifications ──

/// Where a push COULD be sent right now. Addresses rot; see the migration.
model Device {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// FCM registration token. UNIQUE so a reinstall MOVES it between users.
  token      String    @unique
  platform   String    @db.VarChar(16)
  locale     String    @default("ar") @db.VarChar(5)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Set on sign-out. A live token on a signed-out user pushes that person's
  /// reservation to whoever holds the handset next.
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_devices_live")
  @@map("devices")
}

/// The RECORD that a diner was owed a message, independent of delivery.
model Notification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// Machine-readable, like the doc 06 §1 error codes: the CLIENT owns copy.
  type          String    @db.VarChar(60)
  data          Json      @default("{}") @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// A push left the building. Null while unsent.
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  /// The diner saw it.
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)
  /// For the operator, not the diner.
  deliveryError String?   @map("delivery_error")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_notifications_user")
  @@index([createdAt], map: "idx_notifications_unsent")
  @@map("notifications")
}

// ────────────────────────────────────────────────────────────────── shifts ──

model Shift {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId       String    @map("restaurant_id") @db.Uuid
  nameEn             String    @map("name_en") @db.VarChar(60)
  nameAr             String    @map("name_ar") @db.VarChar(60)
  /// 0–6 for weekly rows; NULL when the row is date-specific.
  dayOfWeek          Int?      @map("day_of_week") @db.SmallInt
  /// Set for one-off dates; NULL for weekly rows. CHECK enforces exactly one.
  specificDate       DateTime? @map("specific_date") @db.Date
  opensAt            DateTime  @map("opens_at") @db.Time(6)
  closesAt           DateTime  @map("closes_at") @db.Time(6)
  spansMidnight      Boolean   @default(false) @map("spans_midnight")
  /// {"1-2":90,"3-4":105,"5+":120} — minutes per party-size band.
  defaultTurnMinutes Json      @map("default_turn_minutes") @db.JsonB
  /// Iftar shifts auto-anchor to Maghrib (doc 05 §1).
  isRamadan          Boolean   @default(false) @map("is_ramadan")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, dayOfWeek], map: "idx_shifts_rest_dow")
  @@index([restaurantId, specificDate], map: "idx_shifts_rest_date")
  @@map("shifts")
}

// ────────────────────────────────────────────────────────────────── tables ──

model Table {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId   String    @map("restaurant_id") @db.Uuid
  name           String    @db.VarChar(30)
  minCapacity    Int       @map("min_capacity") @db.SmallInt
  maxCapacity    Int       @map("max_capacity") @db.SmallInt
  zone           TableZone @default(indoor)
  /// Adjacent table ids eligible for combination (doc 05 §2 fallback).
  combinableWith String[]  @map("combinable_with") @db.Uuid
  /// Allocation preference — lower assigns first.
  priority       Int       @default(0) @db.SmallInt
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant        Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservationTables ReservationTable[]

  @@unique([restaurantId, name])
  @@map("tables")
}

// ──────────────────────────────────────────────────── reservations (hot) ──

model Reservation {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-readable, e.g. 'SAH-7K2M'.
  code                  String            @unique @db.VarChar(8)
  restaurantId          String            @map("restaurant_id") @db.Uuid
  /// NULL for walk-in / phone bookings taken by staff.
  userId                String?           @map("user_id") @db.Uuid
  guestName             String?           @map("guest_name") @db.VarChar(120)
  guestPhone            String?           @map("guest_phone") @db.VarChar(20)
  partySize             Int               @map("party_size") @db.SmallInt
  startsAt              DateTime          @map("starts_at") @db.Timestamptz(6)
  /// = startsAt + turn time for the party size.
  endsAt                DateTime          @map("ends_at") @db.Timestamptz(6)
  status                ReservationStatus @default(held)
  source                ReservationSource @default(app)
  specialRequests       String?           @map("special_requests")
  occasion              String?           @db.VarChar(40)
  seatingPref           TableZone?        @map("seating_pref")
  /// Held rows only — now() + 5 min (doc 05 §4).
  holdExpiresAt         DateTime?         @map("hold_expires_at") @db.Timestamptz(6)
  /// Dedupes POST /reservations/holds.
  idempotencyKey        String?           @unique @map("idempotency_key") @db.Uuid
  /// Dedupes POST /reservations/holds/:id/confirm. doc 06 §1 requires an
  /// Idempotency-Key on holds AND confirms; they are separate mutations with
  /// separate keys, so one column cannot serve both. Not in doc 04 — see
  /// docs/decisions/2026-08-01-confirm-idempotency.md.
  confirmIdempotencyKey String?           @unique @map("confirm_idempotency_key") @db.Uuid
  cancelledAt           DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancelReason          String?           @map("cancel_reason")
  /// When the diner acknowledged a RESTAURANT-initiated cancellation.
  ///
  /// NULL keeps the reservation visible in their upcoming list regardless of
  /// date: it leaves that list because they saw it, not because the date
  /// passed. A venue cancellation that silently disappears is how a diner
  /// turns up to a restaurant that is not expecting them.
  cancellationSeenAt    DateTime?         @map("cancellation_seen_at") @db.Timestamptz(6)
  /// Optimistic-lock counter.
  version               Int               @default(0)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id])
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  tables     ReservationTable[]
  review     Review?

  @@index([restaurantId, startsAt], map: "idx_resv_rest_time")
  @@index([userId, startsAt(sort: Desc)], map: "idx_resv_user")
  /// Partial — see the migration. Only the UNACKNOWLEDGED ones are ever
  /// queried, and they are a small, self-clearing subset.
  @@index([userId, startsAt], map: "idx_resv_unacknowledged_cancellation")
  @@map("reservations")
}

// ─────────────────────────────────────── reservation_tables (allocation) ──

/// Join table supporting table combinations. `during` + `active` back the
/// EXCLUDE USING GIST constraint that makes an overlapping allocation
/// physically unstorable — the third and final anti-double-booking layer.
model ReservationTable {
  reservationId String                   @map("reservation_id") @db.Uuid
  tableId       String                   @map("table_id") @db.Uuid
  /// TSTZRANGE [startsAt, endsAt) — set by trigger from the parent reservation.
  during        Unsupported("tstzrange")
  /// Mirrors "reservation status is live" — maintained by trigger.
  active        Boolean                  @default(true)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table       Table       @relation(fields: [tableId], references: [id])

  @@id([reservationId, tableId])
  @@index([tableId], map: "idx_restable_table")
  @@map("reservation_tables")
}
