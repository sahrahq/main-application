<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- COARSE ONLY, and that is the whole permission story.
         `LocationSource` asks for `LocationAccuracy.low` — "which restaurants
         are near me" needs a neighbourhood, not a doorway — so FINE would be
         asking for precision we do not use and will not spend a diner's trust
         on. ACCESS_BACKGROUND_LOCATION is deliberately absent and must stay
         absent: nothing in this product follows anybody around. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ANDROID 13+ (API 33) MAKES NOTIFICATIONS A RUNTIME PERMISSION, and
         without this line the prompt CANNOT BE SHOWN. Not "is denied" —
         cannot be shown: `requestPermission()` returns denied immediately and
         no dialog ever appears.

         Everything NOTIFY-1 built and verified would have reached nobody on a
         modern handset: the FCM adapter, `POST /devices` registration, the
         send path's platform gate, the ask-after-booking prompt. All correct,
         all tested, all silent. That is the shape this repo keeps finding — a
         capability that is never reachable is indistinguishable from one that
         does not exist.

         Guarded by `test/architecture/manifest_permissions_test.dart`, which
         reads the runtime requests OUT OF THE DART SOURCE and fails if any of
         them has no matching `uses-permission`. A list beside the manifest
         would drift; the source is the catalogue. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- `android:label` was the scaffold's "sahra_customer_app", which is
         literally what a diner would have read under the icon. It is a string
         RESOURCE now so `values-ar/` can give it an Arabic name — a hardcoded
         label has no locale.

         This comment sits ABOVE the tag, not between its attributes: a comment
         inside a start tag is not well-formed XML, and the Android manifest
         parser rejects the whole file. Which it did, on the first release
         build. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- WITHOUT THESE TWO, `canLaunchUrl` RETURNS FALSE ON ANDROID 11+
             EVEN WHEN A HANDLER EXISTS. Package visibility was tightened in
             API 30: an app cannot see which activities can handle an intent
             unless it declares the query. The symptom is the worst kind — the
             support address and the venue phone number stop being tappable on
             every modern Android, silently, while working perfectly on the
             emulator image somebody happened to test on.

             `SahraTappableContact` degrades to readable, copyable text when
             the query fails, so this is not a crash. It is the difference
             between the feature working and the feature quietly not. -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- The venue's "get directions" handoff. Same API 30 rule as the two
             above: without this, `canLaunchUrl(geo:...)` is false on every
             Android 11+ handset even though every map app registers for it,
             and the address row silently stops being tappable. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
    </queries>
</manifest>
