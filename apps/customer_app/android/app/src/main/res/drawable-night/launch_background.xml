<?xml version="1.0" encoding="utf-8"?>
<!--
    A FLAT COLOUR AND DELIBERATELY NOTHING ELSE.

    The Dart splash draws a centred TEXT wordmark, not an image
    (`splash_screen.dart` — the wordmark is text). Putting a logo bitmap here
    would mean the OS shows one thing and Flutter replaces it with another a
    few hundred milliseconds later, which is a visible swap rather than an
    invisible handover.

    Matching the background alone makes the transition undetectable: the same
    cream is on screen from the moment the process starts, and the wordmark
    simply appears on it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
