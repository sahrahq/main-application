<?xml version="1.0" encoding="utf-8"?>
<!--
    THE ADAPTIVE ICON. Android 8+ (API 26) masks every launcher icon to a shape
    the device chooses — circle, squircle, teardrop — so a single flat image
    gets its corners cut differently on different handsets.

    Two layers, each 108dp, of which ONLY THE CENTRE 72dp IS GUARANTEED
    VISIBLE. The mark occupies 54.7% of the master, inside that safe zone, so
    the foreground is the master's own framing with no rescale.

    DERIVED, NOT DESIGNED. The foreground was extracted from
    `assets/brand/sahra-icon-full.png` by recovering per-pixel alpha from the
    cream/terracotta blend; the background is the same terracotta as a flat
    colour. A designer's proper two-layer artwork should replace both, and
    nothing here depends on the split being hand-made.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
