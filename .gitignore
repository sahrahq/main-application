# ── Secrets ─────────────────────────────────────────────────────────────
# Never commit real credentials. Commit .env.example instead.
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
key.properties

# Flutter runtime config (DEVELOPMENT.md §4) — .example.json versions ARE committed
**/env/*.json
!**/env/*.example.json
google-services.json
GoogleService-Info.plist
android/app/upload-keystore.jks

# ── Node / NestJS ───────────────────────────────────────────────────────
node_modules/
dist/
build/
coverage/
.nest/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Prisma ──────────────────────────────────────────────────────────────
# Migrations ARE committed. Only generated client output is ignored.
apps/api/prisma/generated/
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# ── Flutter / Dart ──────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml
# Lockfiles: committed for apps, ignored for packages (per Flutter convention)
packages/*/pubspec.lock

# Generated code (Riverpod / freezed / json_serializable / OpenAPI client)
*.g.dart
*.freezed.dart
*.config.dart
*.mocks.dart

# ...except the design tokens. These are NOT build_runner output — they come
# from tool/generate_tokens.dart, which nothing in the build invokes. The file
# has to be committed: without it a fresh clone has no theme and the package
# does not compile, and tokens_coverage_test.dart proves it has not drifted
# from docs/design/tokens.json by comparing against the committed copy.
!packages/sahra_design_system/lib/src/generated/tokens.g.dart
# ...and the generated API client, for the same reason: it is not build_runner
# output, a fresh clone cannot compile without it, and the drift test compares
# against the committed copy.
!packages/sahra_api_client/lib/src/generated/models.g.dart
!packages/sahra_api_client/lib/src/generated/api.g.dart

# Flutter platform build output
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Pods/
**/ios/.symlinks/
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/.cxx/
**/android/app/.cxx/

# ── Terraform ───────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# ── Docker ──────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Editors / OS ────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Claude Code ─────────────────────────────────────────────────────────
# Team settings ARE committed; personal overrides are not.
.claude/settings.local.json

# Golden diff artifacts. Written by flutter_test on a failure so the diff can
# be looked at locally; CI uploads them as a build artifact instead. Never
# committed — they are the output of a failure, not a baseline.
**/test/**/failures/

# ── Flutter generated-but-COMMITTED output ──────────────────────────────
# Same treatment as tokens.g.dart and the API client: generated, committed,
# excluded from formatting, drift-checked in CI. Un-ignored explicitly because
# the blanket `*.g.dart` rule above would otherwise swallow them.
!apps/customer_app/lib/**/*.g.dart
!apps/customer_app/lib/localization/generated/
!apps/customer_app/lib/localization/app_ar.arb
!apps/customer_app/lib/localization/app_en.arb
