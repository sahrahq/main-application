# Normalize line endings so Windows/macOS/Linux checkouts agree.
* text=auto eol=lf

# Binary — never touch these.
*.png    binary
*.jpg    binary
*.webp   binary
*.ttf    binary
*.otf    binary
*.pdf    binary
*.zip    binary
.thumbnail binary

# Generated / vendored — keep out of diffs and language stats.
pnpm-lock.yaml    linguist-generated=true -diff
docs/design/_ds_bundle.js linguist-generated=true -diff
